#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name=$1
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

# CI uses Node 26; the orb base image ships it.
node_major=$(node -p 'process.versions.node.split(".")[0]')
if [[ "$node_major" != 26 ]]; then
  echo "warning: expected Node 26, found $(node -v)" >&2
fi

# package.json pins pnpm via the packageManager field.
pnpm_version=$(node -p 'require("./package.json").packageManager.split("@")[1]')
if [[ "$(pnpm --version 2>/dev/null || true)" != "$pnpm_version" ]]; then
  step "Install pnpm $pnpm_version" sudo npm install -g "pnpm@$pnpm_version"
fi

step "Install dependencies" pnpm install --frozen-lockfile
