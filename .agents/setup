#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name=$1
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@" || return
  echo "<== $name ($((SECONDS - start))s)"
}

# CI uses Node 26; the orb base image ships it.
node_major=$(node -p 'process.versions.node.split(".")[0]')
if [[ "$node_major" != 26 ]]; then
  echo "warning: expected Node 26, found $(node -v)" >&2
fi

# package.json pins pnpm via the packageManager field.
pnpm_version=$(node -p 'require("./package.json").packageManager.split("@")[1]')
if [[ "$(pnpm --version 2>/dev/null || true)" != "$pnpm_version" ]]; then
  step "Install pnpm $pnpm_version" sudo npm install -g "pnpm@$pnpm_version"
fi

step "Install dependencies" pnpm install --frozen-lockfile

# Prebundle dependencies into node_modules/.vite so the orb snapshot has them and
# the first portal page load skips about 0.6 s of bundling. Vite marks
# `vite optimize` deprecated, so a failure here only costs that time.
step "Prebundle Vite dependencies" ./node_modules/.bin/vite optimize ||
  echo "warning: vite optimize failed; the dev server will bundle dependencies on first load" >&2
